{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Extension code under `src/extensions/*/shared/` is compiled by this
    // project *and* by tsconfig.node.json, and is exercised directly by
    // `node --test`, whose type stripping needs the explicit extension on a
    // value import. Allow it here too so one file can satisfy all three.
    "allowImportingTsExtensions": true,
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"],
      "@extensions/*": ["./src/extensions/*"]
    }
  },
  "include": [
    "src/renderer/src/**/*",
    "src/shared/**/*",
    "src/preload/index.d.ts",
    "src/extensions/**/renderer/**/*",
    "src/extensions/**/shared/**/*",
    "src/extensions/**/types.ts",
    "src/extensions/**/ipc/preload.ts",
    "src/extensions/*/screen.ts",
    "src/extensions/*/screen.tsx"
  ],
  "exclude": ["src/**/*.test.ts"]
}
