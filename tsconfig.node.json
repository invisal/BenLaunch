{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "paths": {
      "@benpocket/win": ["./native/win/index.d.ts"],
      "@core/*": ["./src/core/*"],
      "@main/*": ["./src/main/*"],
      "@shared/*": ["./src/shared/*"],
      "@extensions/*": ["./src/extensions/*"]
    },
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/core/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/extensions/**/*",
    "electron.vite.config.ts"
  ],
  "exclude": ["src/extensions/**/renderer/**"]
}
