{
  "name": "BenLaunch",
  "version": "0.0.1",
  "description": "Simple launcher",
  "main": "./out/main/index.js",
  "private": true,
  "type": "module",
  "author": "Visal In",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "test": "node --disable-warning=ExperimentalWarning --test \"src/**/*.test.ts\"",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.10",
    "cnfast": "^0.1.0",
    "codemirror": "^6.0.2",
    "immer": "^11.1.18",
    "mathjs": "^15.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "use-immer": "^0.11.0"
  },
  "optionalDependencies": {
    "@benpocket/win": "file:native/win",
    "electron-liquid-glass": "^1.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^7.3.6"
  }
}
